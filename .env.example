# Copy to .env for local development; replace placeholders with local values.
MYSQL_DATABASE=f1_strategy
MYSQL_USER=f1_app
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-me-local-root
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MONGODB_PORT=27018
MONGODB_URI=mongodb://127.0.0.1:27018/f1_strategy
MONGODB_DATABASE=f1_strategy
API_SECRET_KEY=replace-with-a-long-random-value
API_HOST=127.0.0.1
API_PORT=8001
WEB_ORIGIN=http://localhost:3000
API_PROXY_TARGET=http://127.0.0.1:8001
FASTF1_CACHE_DIR=.cache/fastf1
CHROMA_PATH=.data/chroma
